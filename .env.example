# =====================================================================
# AUTONOM — variáveis de ambiente
# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# Variáveis com prefixo NEXT_PUBLIC_ ficam visíveis no navegador: só coloque
# nelas valores públicos. Todo o resto fica restrito ao servidor.
# =====================================================================

# --- Supabase (OBRIGATÓRIO para login e banco) -----------------------
# Painel Supabase > Project Settings > API
# URL do projeto, no formato https://SEU-PROJETO.supabase.co
# (NÃO é a URL do dashboard em supabase.com/dashboard/...)
NEXT_PUBLIC_SUPABASE_URL=
# Chave "anon" / "publishable": pública, protegida pelas regras RLS do banco
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role": ignora a segurança do banco. SOMENTE no servidor.
# Ainda não é usada pelo código atual; será necessária para webhooks
# (WhatsApp, pagamentos) e tarefas agendadas. Nunca coloque em NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação --------------------------------------------------------
# URL pública do app (usada nos links de e-mail de confirmação/recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Módulos futuros (ainda não utilizados pelo código) ---------------
# Inteligência artificial (agentes, Website Builder)
# ANTHROPIC_API_KEY=
# WhatsApp Business Platform (Meta)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# Pagamentos
# PAYMENT_PROVIDER_SECRET_KEY=
# E-mail transacional
# EMAIL_PROVIDER_API_KEY=
